{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "10 Year Gilt",
    "anchor": "start",
    "subtitle": "Yield, % | Source: BoE through ECO API",
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": "380",
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#ffffff",
  "view": {
    "fill": "#ffffff",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://api.economicsobservatory.com/gbr/intr?vega",
    "format": {
      "type": "json"
    }
  },
  "mark": {
    "type": "line",
    "color": "#66CDAA",
    "strokeWidth": "2"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "title": "",
        "titleColor": "#122B39",
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          16
        ]
      },
      "axis": {
        "title": "",
        "values": [
          0,
          2,
          4,
          6,
          8,
          10,
          12,
          14,
          16
        ],
        "labelExpr": "datum.value + '%'",
        "titleColor": "#122B39",
        "grid": true,
        "gridDash": [
          1,
          4
        ],
        "gridColor": "#d9d9d9"
      }
    }
  }
}